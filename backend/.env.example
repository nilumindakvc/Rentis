DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentis
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=45
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# From your Stripe dashboard, Developers -> API keys (test mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/webhooks/stripe` (local dev)
STRIPE_WEBHOOK_SECRET=
# The country your own Stripe account is registered in (Dashboard -> Settings -> Business details)
STRIPE_PLATFORM_COUNTRY=US
FRONTEND_BASE_URL=http://localhost:5173
